@startuml Use Cases Overview
left to right direction

actor "Operator" as operator
actor "Workflow Author" as author
actor "Time" as time

actor "GitHub" as github <<system>>
actor "Docker Engine" as docker <<system>>

rectangle "scaleset-runner" {
    usecase "UC-001\nDeploy Controller" as UC001
    usecase "UC-002\nAdd Repository" as UC002
    usecase "UC-003\nRemove Repository" as UC003
    usecase "UC-004\nShut Down Controller" as UC004
    usecase "UC-005\nMonitor Controller" as UC005
    usecase "UC-006\nRefresh Runner Images" as UC006
    usecase "UC-007\nRun Job on Host" as UC007
    usecase "UC-008\nCancel Job" as UC008
}

operator --> UC001
operator --> UC002
operator --> UC003
operator --> UC004
operator --> UC005
time --> UC006

author --> UC007
author --> UC008

UC002 ..> UC001 : <<include>>
UC003 ..> UC001 : <<include>>
UC001 ..> UC006 : <<include>>

UC001 --> github
UC002 --> github
UC003 --> github
UC004 --> github
UC007 --> github
UC008 --> github

UC001 --> docker
UC004 --> docker
UC006 --> docker
UC007 --> docker
UC008 --> docker

note right of UC002
  The Config change takes effect
  when the Controller is redeployed.
end note

@enduml
